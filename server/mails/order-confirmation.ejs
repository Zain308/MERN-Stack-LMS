<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title>Order Confirmation</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: #f4f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
        }

        .email-wrapper {
            width: 100%;
            padding: 40px 15px;
            background-color: #f4f7fb;
        }

        .email-container {
            max-width: 650px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        /* Header */

        .header {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            padding: 35px 30px;
            text-align: center;
            color: #ffffff;
        }

        .logo {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .header p {
            font-size: 14px;
            opacity: 0.9;
        }

        /* Main content */

        .content {
            padding: 40px 35px;
        }

        .success-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background-color: #dcfce7;
            color: #16a34a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            font-weight: bold;
        }

        .message {
            text-align: center;
            margin-bottom: 35px;
        }

        .message h1 {
            font-size: 26px;
            color: #111827;
            margin-bottom: 10px;
        }

        .message p {
            font-size: 15px;
            line-height: 1.7;
            color: #6b7280;
        }

        /* Order information */

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 15px;
        }

        .order-info {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 25px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 15px 18px;
            border-bottom: 1px solid #e5e7eb;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #6b7280;
            font-size: 14px;
        }

        .info-value {
            color: #111827;
            font-size: 14px;
            font-weight: 600;
        }

        /* Course */

        .course-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .course-table {
            width: 100%;
            border-collapse: collapse;
        }

        .course-table th {
            text-align: left;
            padding-bottom: 12px;
            font-size: 13px;
            color: #6b7280;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
        }

        .course-table td {
            padding: 18px 0;
            font-size: 14px;
            color: #374151;
            border-bottom: 1px solid #f1f5f9;
        }

        .course-table td:last-child,
        .course-table th:last-child {
            text-align: right;
        }

        .course-name {
            font-weight: 600;
            color: #111827;
        }

        /* Total */

        .total-box {
            background-color: #f8fafc;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .total-row:last-child {
            margin-bottom: 0;
            padding-top: 15px;
            border-top: 1px solid #e5e7eb;
        }

        .total-label {
            color: #6b7280;
            font-size: 14px;
        }

        .total-value {
            color: #374151;
            font-size: 14px;
            font-weight: 600;
        }

        .grand-total .total-label {
            font-size: 17px;
            font-weight: 700;
            color: #111827;
        }

        .grand-total .total-value {
            font-size: 20px;
            color: #2563eb;
        }

        /* Support */

        .support-box {
            margin-top: 30px;
            padding: 20px;
            background-color: #eff6ff;
            border-radius: 10px;
            text-align: center;
        }

        .support-box p {
            color: #4b5563;
            font-size: 14px;
            line-height: 1.6;
        }

        .support-box a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        /* Footer */

        .footer {
            background-color: #f8fafc;
            padding: 25px 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }

        .footer p {
            color: #9ca3af;
            font-size: 12px;
            line-height: 1.6;
        }

        .footer .brand {
            color: #374151;
            font-weight: 600;
            margin-bottom: 5px;
        }

        /* Responsive */

        @media only screen and (max-width: 600px) {

            .email-wrapper {
                padding: 20px 10px;
            }

            .content {
                padding: 30px 20px;
            }

            .header {
                padding: 30px 20px;
            }

            .message h1 {
                font-size: 22px;
            }

            .info-row {
                flex-direction: column;
                gap: 5px;
            }

            .course-table th,
            .course-table td {
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <div class="email-wrapper">

        <div class="email-container">

            <!-- Header -->
            <div class="header">

                <div class="logo">
                    E-Learning
                </div>

                <p>
                    Your learning journey starts here
                </p>

            </div>


            <!-- Main Content -->
            <div class="content">

                <!-- Success Message -->
                <div class="message">

                    <div class="success-icon">
                        ✓
                    </div>

                    <h1>
                        Your Order is Confirmed!
                    </h1>

                    <p>
                        Thank you for your purchase.
                        We're excited to have you with us and hope
                        you enjoy your learning experience.
                    </p>

                </div>


                <!-- Order Details -->
                <div>

                    <div class="section-title">
                        Order Details
                    </div>

                    <div class="order-info">

                        <div class="info-row">

                            <span class="info-label">
                                Order ID
                            </span>

                            <span class="info-value">
                                #<%= order.id %>
                            </span>

                        </div>


                        <div class="info-row">

                            <span class="info-label">
                                Order Date
                            </span>

                            <span class="info-value">
                                <%= order.date %>
                            </span>

                        </div>

                    </div>

                </div>


                <!-- Course -->
                <div>

                    <div class="section-title">
                        Purchased Course
                    </div>

                    <div class="course-card">

                        <table class="course-table">

                            <thead>
                                <tr>

                                    <th>
                                        Course
                                    </th>

                                    <th>
                                        Price
                                    </th>

                                </tr>
                            </thead>

                            <tbody>

                                <tr>

                                    <td class="course-name">
                                        <%= order.name %>
                                    </td>

                                    <td>
                                        $<%= order.price %>
                                    </td>

                                </tr>

                            </tbody>

                        </table>


                        <!-- Total -->
                        <div class="total-box">

                            <div class="total-row">

                                <span class="total-label">
                                    Subtotal
                                </span>

                                <span class="total-value">
                                    $<%= order.price %>
                                </span>

                            </div>


                            <div class="total-row">

                                <span class="total-label">
                                    Tax
                                </span>

                                <span class="total-value">
                                    $0.00
                                </span>

                            </div>


                            <div class="total-row grand-total">

                                <span class="total-label">
                                    Total
                                </span>

                                <span class="total-value">
                                    $<%= order.price %>
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Support -->
                <div class="support-box">

                    <p>
                        Have any questions or need help?
                        Contact our support team at
                        <br>

                        <a href="mailto:support@elearning.com">
                            support@elearning.com
                        </a>
                    </p>

                </div>

            </div>


            <!-- Footer -->
            <div class="footer">

                <p class="brand">
                    © 2026 E-Learning
                </p>

                <p>
                    All rights reserved.
                    This email was sent because you placed an order
                    on our platform.
                </p>

            </div>

        </div>

    </div>

</body>

</html>